# Single-stage version of 05_Docker_Fundamental/React-app: build and serve with Node only.
# Compared against the two-stage version (Node build -> Nginx) to see what the second stage saves.
FROM node:20-alpine
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build
EXPOSE 4173
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "4173"]
